{% schema %}
{
  "name": "OvaBloom Landing",
  "tag": "section",
  "class": "ovb-section",
  "settings": [
    {
      "type": "header",
      "content": "Compra (IDs de variante)"
    },
    {
      "type": "paragraph",
      "content": "Pega aquí el ID numérico de la variante de cada plan. Lo encuentras en Productos → OvaBloom → variante → la URL termina en /variants/ID."
    },
    {
      "type": "text",
      "id": "variant_1",
      "label": "Variante: 1 frasco"
    },
    {
      "type": "text",
      "id": "variant_2",
      "label": "Variante: 2 frascos"
    },
    {
      "type": "text",
      "id": "variant_3",
      "label": "Variante: 3 frascos"
    },
    {
      "type": "header",
      "content": "Suscripción (opcional)"
    },
    {
      "type": "paragraph",
      "content": "Si usan una app de suscripciones, pega el ID del plan de venta (selling plan) de cada opción. Si lo dejan vacío, se compra como compra única."
    },
    {
      "type": "text",
      "id": "selling_plan_1",
      "label": "Selling plan: 1 frasco"
    },
    {
      "type": "text",
      "id": "selling_plan_2",
      "label": "Selling plan: 2 frascos"
    },
    {
      "type": "text",
      "id": "selling_plan_3",
      "label": "Selling plan: 3 frascos"
    },
    {
      "type": "header",
      "content": "Partes de la landing"
    },
    {
      "type": "checkbox",
      "id": "show_topbar",
      "label": "Mostrar barra de ofertas de arriba",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Mostrar header propio de la landing (desactívalo si el tema ya tiene header)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "Mostrar footer propio de la landing (desactívalo si el tema ya tiene footer)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "OvaBloom Landing"
    }
  ]
}
{% endschema %}
